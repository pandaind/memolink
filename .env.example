# ─────────────────────────────────────────────────────────────────────────────
# MemoLink + Headroom — environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Enable the compression profile so the headroom sidecar is automatically pulled and started
COMPOSE_PROFILES=compression

# ── Vault directory ───────────────────────────────────────────────────────────
# Absolute path on the host to your markdown vault folder.
# This is bind-mounted into both containers as /vault.
VAULT_DIR=./vault

# ── API Keys (change before going to production!) ─────────────────────────────
MEMOLINK_KEY_VSCODE=sk-vscode-changeme
MEMOLINK_KEY_CLAUDE=sk-claude-changeme
MEMOLINK_KEY_CI=sk-ci-changeme

# ── Port bindings (host side) ─────────────────────────────────────────────────
MEMOLINK_HOST_PORT=8765
HEADROOM_HOST_PORT=8787

# ── Headroom / kompress settings ──────────────────────────────────────────────
# Model to use for compression.
# kompress-small: 70M params, ~279 MB, 13–29 ms/call  (default, good quality)
# kompress-base:  150M params, ~600 MB, 49–84 ms/call (higher quality)
KOMPRESS_MODEL_ID=chopratejas/kompress-small

# Score threshold: 0.0 = keep all tokens, 1.0 = discard all tokens.
# 0.5 is the default trained threshold.  Lower for more aggressive compression.
KOMPRESS_THRESHOLD=0.5

# Number of words per inference chunk (must match model training; do not change
# unless you are using a domain-specific fine-tune).
KOMPRESS_CHUNK_WORDS=350

# Set to false to disable compression (outputs pass through unchanged).
HEADROOM_ENABLED=true

# Minimum content length (characters) to trigger compression.
# Content shorter than this is returned as-is for performance.
HEADROOM_MIN_CHARS=300
