<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ist.logic</groupId>
        <artifactId>memolink</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>memolink-mcp-server</artifactId>
    <name>memolink-mcp-server</name>
    <description>MCP server exposing MemoLink tools to Claude Desktop, Cursor and other AI agents</description>

    <dependencies>
        <dependency>
            <groupId>ist.logic</groupId>
            <artifactId>memolink-core</artifactId>
        </dependency>
        <!-- Spring AI MCP server (stdio transport) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        <!-- Spring Boot base (web excluded — MCP server uses stdio) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Mustache templating for note format and prompt templates -->
        <dependency>
            <groupId>com.samskivert</groupId>
            <artifactId>jmustache</artifactId>
        </dependency>
        <!-- Spring Security + web: needed at compile time for the HTTP/SSE security
             classes (MemoLinkSecurityConfig, ApiKeyAuthFilter).  Both are guarded
             by @ConditionalOnWebApplication so they activate only in 'http' profile
             runtime; marking optional keeps them out of downstream transitive deps. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- HTTP/SSE mode: mvn package -Phttp  OR  activate profile in mcp.json -->
    <profiles>
        <profile>
            <id>http</id>
            <dependencies>
                <!-- MCP over HTTP/SSE -->
                <dependency>
                    <groupId>org.springframework.ai</groupId>
                    <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
                    <version>${spring-ai.version}</version>
                </dependency>
                <!-- Spring Security for API key authentication -->
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-security</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- DJL uses ServiceLoader (SPI) to discover EngineProviders.
                     Spring Boot's nested-jar classloader blocks SPI from nested
                     jars, so we unpack the DJL engine jars to a temp dir at
                     launch time so ServiceLoader can find them normally. -->
                <configuration>
                    <requiresUnpack>
                        <dependency>
                            <groupId>com.microsoft.onnxruntime</groupId>
                            <artifactId>onnxruntime</artifactId>
                        </dependency>
                    </requiresUnpack>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
